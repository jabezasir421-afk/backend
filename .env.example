# BlueCollar Environment Configuration Template
# Copy this file to .env and configure strong secrets before running in production

# Database Configuration
POSTGRES_DB=bluecollar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_PORT=5432

# Application Configuration
SERVER_PORT=8080
JWT_SECRET=generate-a-secure-256-bit-random-secret-key-for-jwt-signing
STORAGE_PATH=/var/bluecollar/files

# Initial Administrator Credentials
ADMIN_EMAIL=admin@bluecollar.in
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_PHONE=9999999999

# Notifications
NOTIFICATION_EMAIL_ENABLED=false
MAIL_FROM=noreply@bluecollar.in
